kmap 1
id us-norman
layout us
variant norman
name English (Norman)
level3 ralt
key TLDE ` ~
key AE01 1 !
key AE02 2 @
key AE03 3 '#'
key AE04 4 $
key AE05 5 %
key AE06 6 ^
key AE07 7 &
key AE08 8 *
key AE09 9 (
key AE10 0 )
key AE11 - _
key AE12 = +
key AD01 q Q caps
key AD02 w W caps
key AD03 d D caps
key AD04 f F caps
key AD05 k K caps
key AD06 j J caps
key AD07 u U caps
key AD08 r R caps
key AD09 l L caps
key AD10 ; :
key AD11 [ {
key AD12 ] }
key BKSL \ |
key AC01 a A caps
key AC02 s S caps
key AC03 e E caps
key AC04 t T caps
key AC05 g G caps
key AC06 y Y caps
key AC07 n N caps
key AC08 i I caps
key AC09 o O caps
key AC10 h H caps
key AC11 '''' "
key LSGT < > | ¦
key AB01 z Z caps
key AB02 x X caps
key AB03 c C caps
key AB04 v V caps
key AB05 b B caps
key AB06 p P caps
key AB07 m M caps
key AB08 , <
key AB09 . >
key AB10 / ?
key SPCE space
key KPDL KP_Delete KP_Decimal
key CAPS BackSpace
