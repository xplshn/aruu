key AE07 * 0 type=FOUR_LEVEL_ALPHABETIC
key AE08 ) 2 ½ type=FOUR_LEVEL_ALPHABETIC
key AE09 + 4 dead_grave dead_breve type=FOUR_LEVEL_ALPHABETIC
key AE10 ] 6 type=FOUR_LEVEL_ALPHABETIC
key AE11 ! 8 ¡ ⸘ type=FOUR_LEVEL_ALPHABETIC
key AE12 '#' ` dead_grave
key AD01 ; : dead_diaeresis dead_diaeresis
