key AE03 { 5 ¢ type=FOUR_LEVEL_ALPHABETIC
key AE04 } 3 ¥ type=FOUR_LEVEL_ALPHABETIC
key AE05 ( 1 € type=FOUR_LEVEL_ALPHABETIC
