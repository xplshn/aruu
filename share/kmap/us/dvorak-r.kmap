kmap 1
id us-dvorak-r
layout us
variant dvorak-r
name English (Dvorak, one-handed, right)
key TLDE ` ~ dead_grave dead_tilde
key AE01 1 !
key AE02 2 @
key AE03 3 '#'
key AE04 4 $
key AE05 j J caps
key AE06 l L dead_circumflex dead_circumflex caps
key AE07 m M caps
key AE08 f F caps
key AE09 p P dead_grave dead_breve caps
key AE10 / ?
key AE11 [ {
key AE12 ] } dead_tilde
key AD01 5 % dead_acute dead_diaeresis
key AD02 6 ^ dead_cedilla dead_caron
key AD03 q Q dead_abovedot · caps
key AD04 . >
key AD05 o O caps
key AD06 r R caps
key AD07 s S caps
key AD08 u U caps
key AD09 y Y caps
key AD10 b B caps
key AD11 ; :
key AD12 = +
key BKSL \ |
key AC01 7 &
key AC02 8 *
key AC03 z Z caps
key AC04 a A caps
key AC05 e E caps
key AC06 h H caps
key AC07 t T caps
key AC08 d D caps
key AC09 c C caps
key AC10 k K caps
key AC11 - _
key LSGT < > | ¦
key AB01 9 ( dead_ogonek dead_doubleacute
key AB02 0 )
key AB03 x X caps
key AB04 , <
key AB05 i I caps
key AB06 n N caps
key AB07 w W caps
key AB08 v V caps
key AB09 g G caps
key AB10 '''' "
key SPCE space
key KPDL KP_Delete KP_Decimal
