kmap 1
id kz-ext
layout kz
variant ext
name Kazakh (extended)
level3 ralt
key TLDE ё Ё ` ~ caps type=FOUR_LEVEL_ALPHABETIC
key AE01 " ! 1 ! type=FOUR_LEVEL_ALPHABETIC
key AE02 ә Ә 2 @ caps type=FOUR_LEVEL_ALPHABETIC
key AE03 і І 3 '#' caps type=FOUR_LEVEL_ALPHABETIC
key AE04 ң Ң 4 $ caps type=FOUR_LEVEL_ALPHABETIC
key AE05 ғ Ғ 5 % caps type=FOUR_LEVEL_ALPHABETIC
key AE06 , ; 6 ^ type=FOUR_LEVEL_ALPHABETIC
key AE07 . : 7 & type=FOUR_LEVEL_ALPHABETIC
key AE08 ү Ү 8 * caps type=FOUR_LEVEL_ALPHABETIC
key AE09 ұ Ұ 9 ( caps type=FOUR_LEVEL_ALPHABETIC
key AE10 қ Қ 0 ) caps type=FOUR_LEVEL_ALPHABETIC
key AE11 ө Ө - _ caps type=FOUR_LEVEL_ALPHABETIC
key AE12 һ Һ = + caps type=FOUR_LEVEL_ALPHABETIC
key AD01 й Й caps
key AD02 ц Ц caps
key AD03 у У caps
key AD04 к К caps
key AD05 е Е caps
key AD06 н Н caps
key AD07 г Г caps
key AD08 ш Ш caps
key AD09 щ Щ caps
key AD10 з З caps
key AD11 х Х [ { caps type=FOUR_LEVEL_ALPHABETIC
key AD12 ъ Ъ ] } caps type=FOUR_LEVEL_ALPHABETIC
key BKSL \ / | ¦ type=FOUR_LEVEL_ALPHABETIC
key AC01 ф Ф caps
key AC02 ы Ы caps
key AC03 в В caps
key AC04 а А caps
key AC05 п П caps
key AC06 р Р caps
key AC07 о О caps
key AC08 л Л caps
key AC09 д Д caps
key AC10 ж Ж caps
key AC11 э Э '''' caps type=FOUR_LEVEL_ALPHABETIC
key LSGT < > | ¦
key AB01 я Я caps
key AB02 ч Ч caps
key AB03 с С caps
key AB04 м М caps
key AB05 и И caps
key AB06 т Т caps
key AB07 ь Ь caps
key AB08 б Б < caps type=FOUR_LEVEL_ALPHABETIC
key AB09 ю Ю > caps type=FOUR_LEVEL_ALPHABETIC
key AB10 № ? type=FOUR_LEVEL
key SPCE space
key KPDL KP_Delete KP_Decimal
