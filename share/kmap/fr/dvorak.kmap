kmap 1
id fr-dvorak
layout fr
variant dvorak
name French (Dvorak)
key TLDE _ * type=FOUR_LEVEL_SEMIALPHABETIC
key AE01 = 1 type=FOUR_LEVEL_SEMIALPHABETIC
key AE02 / 2 ± type=FOUR_LEVEL_SEMIALPHABETIC
key AE03 - 3 ¼ type=FOUR_LEVEL_SEMIALPHABETIC
key AE04 è 4 ½ type=FOUR_LEVEL_SEMIALPHABETIC
key AE05 \ 5 ¾ type=FOUR_LEVEL_SEMIALPHABETIC
key AE06 dead_circumflex 6 type=FOUR_LEVEL_SEMIALPHABETIC
key AE07 ( 7 type=FOUR_LEVEL_SEMIALPHABETIC
key AE08 ISO_Level3_Latch 8 ` type=FOUR_LEVEL_SEMIALPHABETIC
key AE09 ) 9 type=FOUR_LEVEL_SEMIALPHABETIC
key AE10 " 0 type=FOUR_LEVEL_SEMIALPHABETIC
key AE11 [ + type=FOUR_LEVEL_SEMIALPHABETIC
key AE12 ] % type=FOUR_LEVEL_SEMIALPHABETIC
key AD01 : ? æ Æ
key AD02 '''' < $ type=FOUR_LEVEL_SEMIALPHABETIC
key AD03 é > É type=FOUR_LEVEL_SEMIALPHABETIC
key AD04 g G € caps
key AD05 . ! °
key AD06 h H caps
key AD07 v V caps
key AD08 c C ç Ç caps
key AD09 m M µ caps
key AD10 k K caps
key AD11 z Z caps
key AD12 dead_diaeresis &
key BKSL ~ '#'
key AC01 o O ò Ò caps
key AC02 a A à À caps
key AC03 u U ù Ù caps
key AC04 e E è È caps
key AC05 b B caps
key AC06 f F caps
key AC07 s S « caps
key AC08 t T caps
key AC09 n N » caps
key AC10 d D caps
key AC11 w W caps
key LSGT à ç À Ç / type=FOUR_LEVEL_PLUS_LOCK
key AB01 ; | œ Œ - type=FOUR_LEVEL_PLUS_LOCK
key AB02 q Q { caps
key AB03 , @ }
key AB04 i I ì Ì caps
key AB05 y Y £ caps
key AB06 x X caps
key AB07 r R º caps
key AB08 l L caps
key AB09 p P § caps
key AB10 j J caps
key SPCE space space nobreakspace nobreakspace
key KPDL KP_Delete KP_Decimal
