kmap 1
id keypad:hex
key KPMU KP_Multiply * ) XF86ClearGrab type=FOUR_LEVEL_MIXED_KEYPAD
key KP7 KP_Home KP_7 a type=FOUR_LEVEL_MIXED_KEYPAD
key KP8 KP_Up KP_8 b type=FOUR_LEVEL_MIXED_KEYPAD
key KP9 KP_Prior KP_9 c type=FOUR_LEVEL_MIXED_KEYPAD
key KPSU KP_Subtract - $ XF86Prev_VMode type=FOUR_LEVEL_MIXED_KEYPAD
key KP4 KP_Left KP_4 d type=FOUR_LEVEL_MIXED_KEYPAD
key KP5 KP_Begin KP_5 e type=FOUR_LEVEL_MIXED_KEYPAD
key KP6 KP_Right KP_6 f type=FOUR_LEVEL_MIXED_KEYPAD
key KPAD KP_Add + , XF86Next_VMode type=FOUR_LEVEL_MIXED_KEYPAD
key KP1 KP_End KP_1 = type=FOUR_LEVEL_MIXED_KEYPAD
key KP2 KP_Down KP_2 x type=FOUR_LEVEL_MIXED_KEYPAD
key KP3 KP_Next KP_3 : type=FOUR_LEVEL_MIXED_KEYPAD
key KP0 KP_Insert KP_0 \ type=FOUR_LEVEL_MIXED_KEYPAD
key KPDV KP_Divide / ( XF86Ungrab type=FOUR_LEVEL_MIXED_KEYPAD
key KPEQ KP_Equal =
