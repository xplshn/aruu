#!/bin/sh
# https://srcdump.net/shrub/shrubtools/tree/main/item/deps.html
#
# emit makefile dependencies for a list of C sources using the compiler's .d output. having a bunch of
# autogenerated .d files and -include's is flaky and ugly, and might not work on all make
# implementations. this way you can generate the deps once and ship the makefile.
# it takes a list of files from stdin and prints to stdout. you might also want to append
# you CFLAGS/CPPFLAGS if that will change the deps.
#
# example:
#     find . -type f -name '*.c' | CPPFLAGS='-Iinclude' deps >> Makefile
#
set -eu

cc=${CC:-cc}
cppflags=${CPPFLAGS:-}
cflags=${CFLAGS:-}
tmpbase=${TMPDIR:-/tmp}

cleanup() {
	rm -rf "$tmpdir"
}

usage() {
	printf 'usage: %s [file.c ...]\n' "${0##*/}" >&2
	printf '       %s < file-list\n' "${0##*/}" >&2
	exit 2
}

list() {
	if [ "$#" -gt 0 ]; then
		for src do
			case $src in
			*.c) printf '%s\n' "$src" ;;
			*) printf '%s: not a .c file: %s\n' "${0##*/}" "$src" >&2; exit 2 ;;
			esac
		done
		return
	fi

	while IFS= read -r src; do
		[ -n "$src" ] || continue
		case $src in
		*.c) printf '%s\n' "$src" ;;
		*) printf '%s: not a .c file: %s\n' "${0##*/}" "$src" >&2; exit 2 ;;
		esac
	done
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	usage
fi

tmpdir=$(mktemp -d "$tmpbase/deps.XXXXXX")
trap cleanup EXIT HUP INT TERM

count=0
srcs=$tmpdir/sources
list "$@" > "$srcs"

if [ ! -s "$srcs" ]; then
	printf '%s: no .c files provided\n' "${0##*/}" >&2
	exit 1
fi

printf '\n'
printf '#AUTOGENERATED\n'

while IFS= read -r src; do
	dep=$tmpdir/$count.d
	obj=${src%.c}.o
	"$cc" $cppflags $cflags -MMD -MF "$dep" -MT "$obj" -E -o /dev/null "$src"
	#flatten the block with one target: dep line per prereq
	awk '
	BEGIN {
		rule = ""
	}
	{
		line = $0
		sub(/\\$/, "", line)
		rule = rule line " "
		if ($0 !~ /\\$/) {
			sub(/^[[:space:]]*/, "", rule)
			split(rule, parts, ":")
			target = parts[1]
			deps = substr(rule, length(target) + 2)
			n = split(deps, items, /[[:space:]]+/)
			for (i = 1; i <= n; ++i) {
				if (items[i] == "")
					continue
				print target ": " items[i]
			}
			rule = ""
		}
	}
	' "$dep"
	count=$((count + 1))
done < "$srcs"
